{
  "name": "stackchan-home-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "StackChan 本地扩展中枢，用于机器人固件和后续 Telegram 集成。",
  "scripts": {
    "dev": "pnpm build && node dist/index.js",
    "dev:http": "pnpm build && node dist/http/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.4.0",
    "pino": "^9.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
